{
  "name": "optihub-provider-scraper",
  "version": "2.0.0",
  "description": "High-performance Playwright scraper with session state persistence, API network interception, and B2B gated pricing transformation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "scrape": "tsx src/index.ts",
    "sync:fast": "tsx src/fastSync.ts",
    "sync:fast:headless": "tsx src/fastSync.ts --headless",
    "sync:stock": "tsx src/fastSync.ts",
    "sync:stock:headless": "tsx src/fastSync.ts --headless",
    "sync:stock-prices": "tsx src/fastSync.ts --all-brands --headless",
    "test": "tsx test/pricing.test.ts && tsx test/interceptor.test.ts && tsx test/imageOptimizer.test.ts && tsx test/fastSync.test.ts"
  },
  "keywords": [
    "optihub",
    "scraper",
    "playwright",
    "session-storage",
    "api-interception",
    "b2b-pricing"
  ],
  "author": "OptiHub Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/sharp": "^0.31.1",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
